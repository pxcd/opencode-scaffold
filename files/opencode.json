{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/BASELINE.md",
    ".opencode/WORKFLOW.md",
    ".opencode/PROJECT.md",
    ".opencode/HANDOFFS.md",
    ".opencode/CONTINUATION.md"
  ],
  "experimental": {
    "subagent_depth": 1
  },
  "default_agent": "Cartman",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 12000
    },
    "buffer": 16000
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 12000
  },
  "permissions": [
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "osascript *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "open *",
      "effect": "deny"
    }
  ],
  "plugins": [
    "./.opencode/plugins/step-limit-compat",
    "./.opencode/plugins/continuation-guard",
    "./.opencode/plugins/qa-retry-guard"
  ],
  "agents": {
    "Butters": {
      "model": "lmstudio/qwen/qwen3.8-27b",
      "steps": 32,
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "opencode.json",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*/opencode.json",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": ".opencode/*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*/.config/opencode/*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "opencode.jsonc",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*/opencode.jsonc",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*/.opencode/*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": ".opencode/evidence/*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*/.opencode/evidence/*",
          "effect": "allow"
        }
      ]
    },
    "Kyle": {
      "model": "lmstudio/qwen/qwen3.8-27b",
      "steps": 40,
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": ".opencode/evidence/*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*/.opencode/evidence/*",
          "effect": "allow"
        }
      ]
    },
    "compaction": {
      "model": "lmstudio/qwen3.8-27b-compaction",
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "title": {
      "model": "lmstudio/qwen/qwen3.8-27b",
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "summary": {
      "model": "lmstudio/qwen/qwen3.8-27b",
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "Cartman": {
      "model": "openai/gpt-6.2-sol#medium",
      "steps": 80,
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "Butters",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "Kyle",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "Stan",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "Chef",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push origin codex/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push -u origin codex/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push --set-upstream origin codex/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push* codex/* *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push* codex/*\t*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push* codex/*\n*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push* codex/*\r*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push*:*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push*--force*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push -f*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* -f*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* -uf*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* -qf*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* -vf*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* +*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push*--mirror*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push*--delete*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push -d*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* -d*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* :*",
          "effect": "deny"
        }
      ]
    },
    "Stan": {
      "model": "openai/gpt-6.2-sol#medium",
      "steps": 40,
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "build": {
      "model": "openai/gpt-6.2-sol#medium",
      "steps": 80,
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "Butters",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "Kyle",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "Stan",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "Chef",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push origin codex/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push -u origin codex/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push --set-upstream origin codex/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push* codex/* *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push* codex/*\t*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push* codex/*\n*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push* codex/*\r*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push*:*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push*--force*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push -f*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* -f*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* -uf*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* -qf*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* -vf*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* +*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push*--mirror*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push*--delete*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push -d*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* -d*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* :*",
          "effect": "deny"
        }
      ],
      "mode": "primary",
      "description": "Desktop entry for the scaffold coordinator",
      "system": "{file:.opencode/agents/Cartman.md}"
    },
    "Chef": {
      "model": "openai/gpt-6.2-astra#high",
      "steps": 20,
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": ".env*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*/.env*",
          "effect": "deny"
        }
      ]
    }
  },
  "model": "openai/gpt-6.2-sol#medium",
  "enabled_providers": [
    "openai",
    "lmstudio"
  ],
  "providers": {
    "lmstudio": {
      "models": {
        "qwen/qwen3.8-27b": {
          "name": "qwen/qwen3.8-27b",
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "body": {
            "temperature": 0.2,
            "reasoning_effort": "none"
          }
        },
        "qwen3.8-27b-compaction": {
          "modelID": "qwen/qwen3.8-27b",
          "name": "Qwen3.8-27B Compaction",
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "body": {
            "temperature": 0.2,
            "reasoning_effort": "none"
          }
        }
      }
    }
  }
