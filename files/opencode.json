{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/BASELINE.md",
    ".opencode/WORKFLOW.md",
    ".opencode/PROJECT.md",
    ".opencode/HANDOFFS.md",
    ".opencode/CONTINUATION.md"
  ],
  "experimental": {
    "subagent_depth": 1
  },
  "default_agent": "Cartman",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 12000
    },
    "buffer": 16000
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 12000
  },
  "permissions": [
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "osascript *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "open *",
      "effect": "deny"
    }
  ],
  "plugins": [
    "./.opencode/plugins/step-limit-compat",
    "./.opencode/plugins/continuation-guard"
  ],
  "agents": {
    "Butters": {
      "model": "lmstudio/swift-1.5-qwen3.8-27b-splash",
      "steps": 32,
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "opencode.json",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*/opencode.json",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": ".opencode/*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*/.config/opencode/*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "opencode.jsonc",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*/opencode.jsonc",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*/.opencode/*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": ".opencode/evidence/*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*/.opencode/evidence/*",
          "effect": "allow"
        }
      ]
    },
    "Kyle": {
      "model": "lmstudio/swift-1.5-qwen3.8-27b-splash",
      "steps": 40,
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": ".opencode/evidence/*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*/.opencode/evidence/*",
          "effect": "allow"
        }
      ]
    },
    "compaction": {
      "model": "lmstudio/swift-1.5-qwen3.8-27b-splash",
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "title": {
      "model": "lmstudio/swift-1.5-qwen3.8-27b-splash",
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "summary": {
      "model": "lmstudio/swift-1.5-qwen3.8-27b-splash",
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "Cartman": {
      "model": "openai/gpt-6.2-sol#medium",
      "steps": 80,
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "Butters",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "Kyle",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "Stan",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push origin codex/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push -u origin codex/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push --set-upstream origin codex/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push* codex/* *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push* codex/*\t*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push* codex/*\n*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push* codex/*\r*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push*:*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push*--force*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push -f*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* -f*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* -uf*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* -qf*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* -vf*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* +*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push*--mirror*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push*--delete*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push -d*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* -d*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* :*",
          "effect": "deny"
        }
      ]
    },
    "Stan": {
      "model": "openai/gpt-6.2-sol#medium",
      "steps": 40,
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "build": {
      "model": "openai/gpt-6.2-sol#medium",
      "steps": 80,
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
