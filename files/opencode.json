          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "Stan",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push origin codex/*",
          "effect": "allow"
