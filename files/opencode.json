          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* -vf*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* +*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push*--mirror*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push*--delete*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push -d*",
