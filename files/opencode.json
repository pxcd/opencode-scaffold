        },
        {
          "action": "shell",
          "resource": "git push* -d*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push* :*",
          "effect": "deny"
        }
      ],
      "mode": "primary",
      "description": "Desktop entry for the scaffold coordinator",
      "system": "{file:.opencode/agents/Cartman.md}"
    }
  },
  "model": "openai/gpt-6.2-sol#medium",
  "enabled_providers": [
    "openai",
    "lmstudio"
  ]
